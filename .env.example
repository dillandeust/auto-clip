# --- LLM (détection de moments) : Ollama local, 100% gratuit ---
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=
LLM_TIMEOUT=600

# --- Transcription ---
TRANSCRIBE_BACKEND=whisper

# --- Gemini (optionnel : active les passes vision ; vide = texte seul, gratuit) ---
GEMINI_API_KEY=

# --- AutoClip ---
AUTOCLIP_DB=autoclip.db
PROFILES_DIR=profiles
LOGS_DIR=logs
AUTOCLIP_HEADLESS=false
AUTOCLIP_MAX_ATTEMPTS=3
