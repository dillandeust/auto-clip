+@app.get("/api/social/manual")
+async def autoclip_social_manual(request: Request):
+    rows = _ac_queue.list_by_status(_ac_conn, _ac_queue.NEEDS_MANUAL)
+    items = []
+    for r in rows:
+        clip = {}
+        job = jobs.get(r["job_id"]) or {}
+        clips = (job.get("result") or {}).get("clips") or []
+        if 0 <= r["clip_index"] < len(clips):
+            clip = clips[r["clip_index"]]
+        items.append({
+            "id": r["id"], "platform": r["platform"], "caption": r["caption"],
+            "last_error": r["last_error"], "download_url": clip.get("video_url", ""),
+        })
+    return {"items": items}
